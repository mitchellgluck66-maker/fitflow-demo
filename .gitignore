# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases (SQLite legacy + embedded PGlite dev DB)
db/*.db
db/*.db-*
db/pglite/

# local artifacts
*.tgz
!.env.example
_to_delete/

# Analyst replay recordings that still hold real names (never committed; re-record with the scrubber)
tests/fixtures/analyst-replay/*.local

# generated verification outputs (per-person diffs with customer names) and local tooling logs
/docs/verification/
/.claude/tint.log
/Claude outputs/
