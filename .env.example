# FitFlow — environment variables (no real values here; copy to .env.local)

# ---- Authentication (REQUIRED in production) --------------------------------
# The deployment is public on the internet and holds real client data + stored
# API credentials. proxy.ts (Next's request interceptor) protects every page
# and API route with a session cookie:
#   APP_PASSWORD  the team password typed on /login (long, random).
#   AUTH_SECRET   ≥ 32 random bytes; signs the session cookie (HMAC-SHA256).
#                 Rotating it signs everyone out.   openssl rand -base64 48
# Production/preview with either unset → the app FAILS CLOSED (503, no data).
# Local dev with both unset → auth is skipped.
APP_PASSWORD=
AUTH_SECRET=

# ---- Database --------------------------------------------------------------
# Supabase Postgres connection string. Use the *session* or *transaction*
# pooler URL from Supabase → Project Settings → Database → Connection string.
# Leave UNSET locally to use the embedded PGlite Postgres in ./db/pglite.
DATABASE_URL=

# ---- GoHighLevel (READ-ONLY) -----------------------------------------------
# Prefer entering these in /setup (stored in the settings table, masked).
# Env vars are the fallback. Private Integration Token needs only read scopes:
# calendars.readonly, calendars/events.readonly, contacts.readonly,
# opportunities.readonly, locations.readonly, users.readonly
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ---- Scheduling -------------------------------------------------------------
# Vercel sets this automatically for cron invocations when defined in the
# project's env vars; /api/cron/* rejects requests without it in production.
CRON_SECRET=

# Business timezone default (overridable in /settings). Weeks are Sun–Sat.
BUSINESS_TIMEZONE=America/New_York

# ---- Email (Resend) — Phase B -------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Money rails — Phase C --------------------------------------------------
# Long-lived user/system-user token with ads_read. Prefer entering in /setup (masked).
META_ACCESS_TOKEN=
# With or without the act_ prefix.
META_AD_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ---- Intelligence — Phase D -------------------------------------------------
# Prefer pasting the key in /setup (masked). Powers insight cards, the weekly
# narrative and stage-role suggestions. Model override: settings anthropic_model.
ANTHROPIC_API_KEY=
SENTRY_DSN=

# ---- Local overrides ---------------------------------------------------------
# PGLITE_DATA_DIR=memory   # in-memory embedded DB (used by tests)

# ---- Google Ads (Phase D) — pending Google's developer-token approval -------
# Prefer entering these in /setup (masked). Partial saves are kept; the CSV
# upload on the Ads tab covers Google spend until OAuth is granted.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Sentry (optional) — silent when unset -----------------------------------
# SENTRY_DSN is already listed above; sync failures are captured when it is set.
