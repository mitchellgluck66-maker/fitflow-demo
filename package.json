{
  "name": "fitflow-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx db/seed.ts",
    "sync:now": "tsx scripts/sync-now.ts",
    "backfill": "tsx scripts/backfill.ts",
    "verify:readonly": "bash scripts/verify-readonly.sh",
    "check": "npm run typecheck && npm run test && npm run verify:readonly && npm run build",
    "sync:meta": "tsx scripts/sync-meta.ts",
    "sync:stripe": "tsx scripts/sync-stripe.ts",
    "db:seed:demo": "tsx db/seed-demo.ts",
    "db:wipe:demo": "tsx scripts/wipe-demo.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "reclassify:payments": "tsx scripts/reclassify-payments.ts",
    "reclassify:attribution": "tsx scripts/reclassify-attribution.ts",
    "reclassify": "npm run reclassify:payments && npm run reclassify:attribution"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@electric-sql/pglite": "^0.5.7",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.49.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
